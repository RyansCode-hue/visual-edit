{
  "name": "visual-edit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "PoC: a visual editor for running web apps. Repo mode edits React/Mantine source; URL mode edits any site and hands off a prompt.",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bin/visual-edit.js open",
    "attune": "node bin/run.js"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "magic-string": "^0.30.17",
    "modern-screenshot": "^4.7.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "visual-edit": "bin/visual-edit.js"
  }
}
